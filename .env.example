# ============================================================
# BLESSED - Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha os valores.
# O ".env.local" NUNCA deve ir para o GitHub (é segredo).
# ============================================================

# Segredo usado para assinar a sessão de login (troque por um texto longo e secreto)
SECRETO_SESSAO=coloque-um-texto-secreto-aqui

# -- Banco na nuvem (Turso) -- usado APENAS em produção (Vercel).
# Em desenvolvimento local, o site usa o arquivo data/blessed.db automaticamente.
# Crie a conta em https://turso.tech -> New Database -> copie estas duas informações.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# -- Fotos na nuvem (Vercel Blob) -- usado APENAS em produção (Vercel).
# Em desenvolvimento local, as fotos vão para public/uploads automaticamente.
# No Vercel -> Project -> Storage -> Create Database (Blob) -> copie o token.
BLOB_READ_WRITE_TOKEN=

# -- Email (Resend) - ainda não configurado (adiado por enquanto) --
RESEND_API_KEY=
EMAIL_REMETENTE=

# -- Pagamento (Stripe) - opcional, deixe vazio até configurar --
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=